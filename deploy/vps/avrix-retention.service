[Unit]
Description=Apply AVRIX enquiry retention policy
After=postgresql.service

[Service]
Type=oneshot
User=avrix
Group=avrix
WorkingDirectory=/opt/avrix-website/current/backend
EnvironmentFile=/opt/avrix-website/shared/backend.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.vps
ExecStart=/opt/avrix-website/current/.venv/bin/python manage.py purge_old_enquiries
Slice=avrix.slice
Nice=19
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/avrix-website/shared
