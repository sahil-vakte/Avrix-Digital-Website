[Unit]
Description=Retry pending AVRIX notification emails
After=network.target postgresql.service

[Service]
Type=oneshot
User=avrix
Group=avrix
WorkingDirectory=/opt/avrix-website/current/backend
EnvironmentFile=/opt/avrix-website/shared/backend.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.vps
ExecStart=/opt/avrix-website/current/.venv/bin/python manage.py send_pending_emails
Slice=avrix.slice
Nice=15
UMask=0027
TimeoutStartSec=50
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/avrix-website/shared
