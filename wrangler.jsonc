{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "avrix-digital-website",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api", "/api/*", "/manage-7f3k", "/manage-7f3k/*", "/admin-setup", "/admin-setup/*", "/static/*"]
  },
  "containers": [{
    "class_name": "Backend",
    "scheduling_policy": "durable_object",
    "images": { "base": { "dockerfile": "./Dockerfile" } }
  }],
  "durable_objects": { "bindings": [{ "name": "BACKEND", "class_name": "Backend" }] },
  "exports": { "Backend": { "type": "durable-object", "storage": "sqlite" } }
}
