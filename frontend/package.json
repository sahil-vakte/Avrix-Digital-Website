{
  "name": "avrix-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/prepare.ts && vite --host 127.0.0.1",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "build": "node --import tsx scripts/prepare.ts && vite-react-ssg build && node --import tsx scripts/generate.ts",
    "preview": "vite preview --host 0.0.0.0",
    "seo:check": "node --import tsx scripts/seo-check.ts",
    "lint": "eslint src scripts vite.config.ts",
    "typecheck": "node --import tsx scripts/prepare.ts && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@hookform/resolvers": "7.0.5",
    "lenis": "1.3.27",
    "lucide-react": "1.72.0",
    "motion": "14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-helmet-async": "3.0.0",
    "react-hook-form": "7.92.0",
    "react-router-dom": "7.18.5",
    "vite-react-ssg": "0.9.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/cli": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/mulish": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/mulish": "^5.3.0",
    "@lhci/cli": "0.16.0",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "beasties": "0.5.5",
    "cheerio": "1.2.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "gray-matter": "4.0.3",
    "jsdom": "31.0.0",
    "linkinator": "8.1.0",
    "marked": "18.2.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "sanitize-html": "2.18.1",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wawoff2": "2.0.1",
    "wrangler": "4.160.0"
  }
}
