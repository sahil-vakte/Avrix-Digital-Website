{
  "name": "avrix-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/prepare.ts && vite --host 127.0.0.1",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "build": "node --import tsx scripts/prepare.ts && vite-react-ssg build && node --import tsx scripts/generate.ts",
    "preview": "vite preview --host 0.0.0.0",
    "seo:check": "node --import tsx scripts/seo-check.ts",
    "lint": "eslint src scripts vite.config.ts",
    "typecheck": "node --import tsx scripts/prepare.ts && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.2.5",
    "@fontsource-variable/geist": "5.2.5",
    "@fontsource-variable/geist-mono": "5.2.5",
    "@fontsource/instrument-serif": "5.2.5",
    "@hookform/resolvers": "3.10.0",
    "lenis": "1.2.3",
    "lucide-react": "0.468.0",
    "motion": "12.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "1.3.0",
    "react-hook-form": "7.55.0",
    "react-router-dom": "6.30.6",
    "vite-react-ssg": "0.8.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@axe-core/cli": "4.10.1",
    "@eslint/js": "9.22.0",
    "@fontsource/bricolage-grotesque": "5.2.5",
    "@lhci/cli": "0.14.0",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/react": "16.2.0",
    "@types/node": "22.13.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/sanitize-html": "2.13.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.21",
    "beasties": "0.1.0",
    "cheerio": "1.0.0",
    "eslint": "9.22.0",
    "globals": "16.0.0",
    "gray-matter": "4.0.3",
    "jsdom": "26.0.0",
    "linkinator": "6.1.2",
    "marked": "15.0.7",
    "postcss": "8.5.30",
    "prettier": "3.5.3",
    "sanitize-html": "2.14.0",
    "satori": "0.12.2",
    "sharp": "0.33.5",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.26.1",
    "vite": "5.4.21",
    "vitest": "2.1.9",
    "wawoff2": "2.0.1",
    "wrangler": "3.114.1"
  }
}
